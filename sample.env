SEARXNG_ENGINES=duckduckgo,brave
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=8
SEARCH_CACHE_TTL_SECONDS=86400

# Social Caption Defaults
SOCIAL_PLATFORMS=X, Instagram, LinkedIn, Facebook
SOCIAL_CTA_TARGET=download the Propt App for the full analysis

# Redis Configuration
REDIS_URL=
REDIS_QUEUE_NAME=n
REDIS_DLQ_NAME=

# Database Configuration

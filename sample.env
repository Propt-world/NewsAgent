MONGO_DB_NAME=

# Browserless Configuration
BROWSERLESS_URL=
BROWSERLESS_TOKEN=

# Email Configuration
SMTP_SERVER=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# Main API URL (Submit_Job)
MAIN_API_URL=

# API Key for accessing endpoints
NEWSAGENT_API_KEY=nX3h1BLgu2Qk2oW-luoBk1zCxfOmVKkuzVj_wbYwAAY

# Webhook Configuration
WEBHOOK_URL=
WEBHOOK_SECRET=

# dB value for Source through Scheduler
SUBMISSION_SOURCE_ID=

# Real-estate check before processing articles the scheduler finds (true to enable; off by default).
# Off-topic articles are marked "not_real_estate" and skip every costly step. Manual submissions are never checked.
# Read by the worker. Deploy the scheduler, API and worker first, then switch it on.
REAL_ESTATE_CHECK_ENABLED=false
REAL_ESTATE_CHECK_TEMPERATURE=0
REAL_ESTATE_CHECK_CHARS=1500

# Newsroom API on the scheduler (true to enable; unset or false = off, nothing mounted)
NEWSROOM_ENABLED=false
# social_scrapper's database, where the signals are read (same cluster as DATABASE_URL).
# The Newsroom's own collections live in MONGO_DB_NAME with the articles.
NEWSROOM_SIGNALS_DB_NAME=newsroom
# "Similar articles" for approved articles: minimum match score (0-1)
NEWSROOM_SIMILARITY_MIN_SCORE=0.8
# Compose (Propt Newsroom articles/signals): writing model and spending limits
NEWSROOM_COMPOSE_MODEL=gpt-4o-mini
# Compose temperatures (separate from MODEL_TEMPERATURE): the Writer, and the
# Researcher/Editor/extract-signal decision (facts and checks, like MODEL_TEMPERATURE)
NEWSROOM_COMPOSE_TEMPERATURE=0.7
NEWSROOM_COMPOSE_CHECK_TEMPERATURE=0.5
NEWSROOM_COMPOSE_PER_HOUR=10
NEWSROOM_COMPOSE_CONCURRENT=2
NEWSROOM_DAILY_BUDGET_USD=10
NEWSROOM_BUDGET_TIMEZONE=Asia/Dubai
# Held back from the budget for each queued/running job
NEWSROOM_COMPOSE_RESERVE_USD=0.05
# Price used when the model is not in the price list (default gpt-4o, per 1M tokens)
NEWSROOM_FALLBACK_INPUT_USD_PER_1M=2.50
NEWSROOM_FALLBACK_OUTPUT_USD_PER_1M=10.00
# Counted from when the worker starts the job
NEWSROOM_COMPOSE_TIMEOUT_MINUTES=15
# Longest wait in the queue before a job is given up (nothing charged)
NEWSROOM_COMPOSE_MAX_WAIT_HOURS=6
# Starts in total when a worker shutdown cuts a job off
NEWSROOM_COMPOSE_MAX_ATTEMPTS=3
NEWSROOM_COMPOSE_QUEUE=newsroom_compose_jobs
# Alerts: backoffice banner + "NEWSROOM_ALERT <code>: ..." log lines (CloudWatch metric filter on NEWSROOM_ALERT)
NEWSROOM_ALERT_CHECK_MINUTES=10
NEWSROOM_ALERT_WORKER_MINUTES=5
NEWSROOM_ALERT_QUEUE_MINUTES=10
NEWSROOM_ALERT_BUDGET_SHARE=0.8
NEWSROOM_ALERT_FILTERED_SHARE=0.5
